# Files that run on Linux (the server, the CI runner) must keep LF even when
# checked out on Windows: a CRLF bash script fails with "$'\r': command not
# found", and a CRLF crontab line runs a command with a trailing \r.
*.sh              text eol=lf
infra/*           text eol=lf
.github/**/*.yml  text eol=lf
