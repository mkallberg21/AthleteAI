# Copy to ~/offdays/infra/.env.prod ON THE SERVER and fill it in. Never commit
# the filled copy (.gitignore covers infra/.env.prod). deploy.sh refuses to
# start without it and refuses if a REQUIRED value is blank.
#
# Every variable is explained in ops/PRODUCTION_CHECKLIST.md.

# --- REQUIRED ---------------------------------------------------------------
# Public URL, no trailing slash. Used in email links and push payloads.
OFFDAYS_BASE_URL=https://app.0ffdays.com
# Signs unsubscribe links. Generate:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
OFFDAYS_SECRET=
# A coach with no team assignment sees nothing rather than the whole program.
# Always on for a new deployment.
OFFDAYS_STRICT_TEAM_SCOPE=1

# --- Email (weekly digest, guardian copies, parent report) --------------------
# Unset = mail is composed and shown in-app but never sent.
OFFDAYS_SMTP_HOST=
OFFDAYS_SMTP_PORT=587
OFFDAYS_SMTP_USER=
OFFDAYS_SMTP_PASSWORD=
OFFDAYS_SMTP_FROM=0FFDAYS <no-reply@0ffdays.com>

# --- Delivery webhooks (bounces/complaints). Empty = that endpoint is off. -----
# Set only the provider you actually send through.
OFFDAYS_WEBHOOK_SECRET_SENDGRID=
OFFDAYS_WEBHOOK_SECRET_POSTMARK=
OFFDAYS_WEBHOOK_SECRET_MAILGUN=
# Amazon SES via SNS: comma-separated topic ARNs to accept. Empty = off.
OFFDAYS_SNS_TOPIC_ARNS=

# --- Web Push. Unset = notifications appear in-app only. ----------------------
# Generate a pair once:  npx web-push generate-vapid-keys
OFFDAYS_VAPID_PUBLIC_KEY=
OFFDAYS_VAPID_PRIVATE_KEY=
OFFDAYS_VAPID_EMAIL=mailto:mkallberg@k6-labs.com

# --- Guess throttle (sign-in / claim / invite codes). Defaults shown. ----------
OFFDAYS_AUTH_MAX_FAILURES=8
OFFDAYS_AUTH_LOCKOUT_SECONDS=30
OFFDAYS_AUTH_LOCKOUT_MAX_SECONDS=3600
OFFDAYS_AUTH_FAILURE_WINDOW_SECONDS=900

# --- Host port (bound to 127.0.0.1 only; nginx proxies to it) ------------------
PORT_APP=8810
